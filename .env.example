DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional. Defaults to the "BVO" custom voice already set up in this
# ElevenLabs account if unset.
ELEVENLABS_VOICE_ID=

# Optional. PyAudio device index for the mic/speaker, from
# list_audio_devices.py. Leave unset to use the system default device for
# each. Set both when the mic and speaker are two different physical
# devices (e.g. two separate Bluetooth peripherals).
MIC_DEVICE_INDEX=
SPEAKER_DEVICE_INDEX=
