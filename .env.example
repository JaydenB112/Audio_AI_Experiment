DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional. Defaults to the "BVO" custom voice already set up in this
# ElevenLabs account if unset.
ELEVENLABS_VOICE_ID=

# Optional. Case-insensitive substring match against a device name from
# list_audio_devices.py -- not a raw index, since indices shift whenever a
# USB device is plugged/unplugged. Leave unset to use the system default
# device for each. Set both when the mic and speaker are two different
# physical devices.
MIC_DEVICE_NAME=
SPEAKER_DEVICE_NAME=

# Optional WebRTC AEC timing hint in milliseconds. Pipecat writes local
# output in 40 ms chunks by default. If echo remains, tune this to match the
# delay from speaker playback to that sound arriving at the microphone.
AEC_STREAM_DELAY_MS=40
